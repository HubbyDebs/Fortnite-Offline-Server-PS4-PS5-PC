+void AFortGameModeAthena::StartMatchTelemetry()
+{
+#if WITH_SERVER_CODE
+    if (!MatchTelemetry || MatchTelemetry->GameMode.Get() != this)
+    {
+        MatchTelemetry = std::make_shared<FTelemetryWatch>();
+        MatchTelemetry->GameMode = FWeakObjectPtr(this);
+    }
+    const std::shared_ptr<FTelemetryWatch> Watch = MatchTelemetry;
+    if (Watch->bSending || Watch->bUnsupported)
+    {
+        return;
+    }
+    AFortGameStateAthena* GameState = AthenaGameStateOf(this);
+    if (!GameState)
+    {
+        SetGameModeTimer(this, Watch->Timer, TelemetryInterval, [](AFortGameModeAthena* GameMode) { GameMode->StartMatchTelemetry(); });
+        return;
+    }
+
+    const std::string Phase = EscapeJson(GameState->GamePhase.ToString());
+    const std::string PhaseStep = AFortGameStateAthena::HasGamePhaseStep() ? EscapeJson(GameState->GamePhaseStep.ToString()) : std::string();
+    const float TimeLeft = AFortGameStateAthena::HasGamePhaseStep() ? std::max(0.0f, static_cast<float>(GameState->GamePhaseStepTimeRemaining)) : 0.0f;
+    const int32_t PlayersLeft = static_cast<int32_t>(GameState->PlayersLeft);
+    const int32_t TotalPlayers = AFortGameStateAthena::HasTotalPlayers() ? static_cast<int32_t>(GameState->TotalPlayers) : PlayersLeft;
+
+    std::string Body = std::format("{{\"phase\":\"{}\",\"phaseStep\":\"{}\",\"timeRemaining\":{:.1f},\"playersLeft\":{},\"totalPlayers\":{}",
+        Phase, PhaseStep, TimeLeft, PlayersLeft, TotalPlayers);
+
+    // Storm circle (current + next safe zone)
+    AFortSafeZoneIndicator* Indicator = AFortGameStateAthena::HasSafeZoneIndicator() ? static_cast<AFortSafeZoneIndicator*>(GameState->SafeZoneIndicator) : static_cast<AFortSafeZoneIndicator*>(SafeZoneIndicator);
+    if (Indicator)
+    {
+        const FVector Cur = Indicator->GetSafeZoneCenter();
+        const float CurR = static_cast<float>(Indicator->Radius);
+        const FVector Next = AFortSafeZoneIndicator::HasNextCenter() ? static_cast<FVector>(Indicator->NextCenter) : Cur;
+        const float NextR = static_cast<float>(Indicator->NextRadius);
+        Body += std::format(",\"storm\":{{\"phase\":{},\"x\":{:.0f},\"y\":{:.0f},\"radius\":{:.0f},\"nextX\":{:.0f},\"nextY\":{:.0f},\"nextRadius\":{:.0f}}}",
+            static_cast<int32_t>(SafeZonePhase), Cur.X, Cur.Y, CurR, Next.X, Next.Y, NextR);
+    }
+
+    // Battle Bus position while flying
+    if (AFortGameStateAthena::HasAircrafts())
+    {
+        const TArray<AFortAthenaAircraft*>& Aircrafts = GameState->Aircrafts;
+        if (Aircrafts.Num() > 0 && Aircrafts[0])
+        {
+            AActor* Bus = reinterpret_cast<AActor*>(Aircrafts[0]);
+            const FVector Pos = Bus->GetTransform().Translation;
+            const float Yaw = Bus->GetActorRotation().Yaw;
+            Body += std::format(",\"bus\":{{\"x\":{:.0f},\"y\":{:.0f},\"yaw\":{:.1f}}}", Pos.X, Pos.Y, Yaw);
+        }
+    }
+
+    FCoreAthenaBotManager* BotManager = FCoreAthenaBotManager::Get();
+    if (BotManager && !Watch->bSentPois && !BotManager->GetLandingSpots().empty())
+    {
+        Watch->bSentPois = true;
+        Body += ",\"pois\":[";
+        bool bFirstPoi = true;
+        for (const FCoreAthenaBotLandingSpot& Spot : BotManager->GetLandingSpots())
+        {
+            if (Spot.Name.empty())
+            {
+                continue;
+            }
+            Body += std::format("{}{{\"name\":\"{}\",\"x\":{:.0f},\"y\":{:.0f}}}",
+                bFirstPoi ? "" : ",", EscapeJson(Spot.Name), Spot.Location.X, Spot.Location.Y);
+            bFirstPoi = false;
+        }
+        Body += "]";
+    }
+
+    // Actors: human players + CoreV2 player bots
+    Body += ",\"actors\":[";
+    bool bFirstActor = true;
+
+    const TArray<AFortPlayerControllerAthena*>& Humans = AlivePlayers;
+    for (int32_t Index = 0; Index < Humans.Num(); ++Index)
+    {
+        AFortPlayerControllerAthena* PC = Humans[Index];
+        if (!PC)
+        {
+            continue;
+        }
+        APawn* RawPawn = PC->GetPawn();
+        if (RawPawn && FCoreAthenaBotManager::IsBotPawn(reinterpret_cast<UObject*>(RawPawn)))
+        {
+            continue;
+        }
+        AFortPawn* Pawn = RawPawn ? Cast<AFortPawn>(reinterpret_cast<UObject*>(RawPawn)) : nullptr;
+        AFortPlayerStateAthena* PS = Cast<AFortPlayerStateAthena>(reinterpret_cast<UObject*>(static_cast<APlayerState*>(PC->PlayerState)));
+        const std::string Name = PS ? EscapeJson(PS->GetPlayerName().ToStdString()) : std::format("Player{}", Index + 1);
+        const FVector Loc = Pawn ? reinterpret_cast<AActor*>(Pawn)->GetTransform().Translation : FVector(0.0f, 0.0f, 0.0f);
+        const float Yaw = Pawn ? reinterpret_cast<AActor*>(Pawn)->GetActorRotation().Yaw : 0.0f;
+        const float Hp = Pawn ? Pawn->GetHealth() : 0.0f;
+        const float MaxHp = Pawn ? Pawn->GetMaxHealth() : 100.0f;
+        const float Shield = Pawn ? Pawn->GetShield() : 0.0f;
+        const float MaxShield = Pawn ? Pawn->GetMaxShield() : 100.0f;
+        const bool bDbno = Pawn && Pawn->bIsDBNO;
+        const int32_t Kills = PS ? PS->GetKills() : 0;
+        const int32_t Team = PS ? static_cast<int32_t>(static_cast<uint8_t>(PS->TeamIndex)) : 0;
+        Body += std::format("{}{{\"id\":\"p{}\",\"name\":\"{}\",\"isBot\":false,\"x\":{:.0f},\"y\":{:.0f},\"z\":{:.0f},\"yaw\":{:.1f},\"hp\":{:.0f},\"maxHp\":{:.0f},\"shield\":{:.0f},\"maxShield\":{:.0f},\"alive\":true,\"dbno\":{},\"kills\":{},\"team\":{},\"state\":\"{}\"}}",
+            bFirstActor ? "" : ",", Index, Name, Loc.X, Loc.Y, Loc.Z, Yaw, Hp, MaxHp, Shield, MaxShield,
+            bDbno ? "true" : "false", Kills, Team, Pawn ? "Landed" : "InAircraft");
+        bFirstActor = false;
+    }
+
+    if (BotManager)
+    {
+        for (const std::unique_ptr<FCoreAthenaBotController>& Bot : BotManager->GetPlayerBots())
+        {
+            if (!Bot)
+            {
+                continue;
+            }
+            AFortPawn* Pawn = reinterpret_cast<AFortPawn*>(Bot->GetPawn());
+            AActor* PosActor = Pawn ? reinterpret_cast<AActor*>(Pawn) : Bot->GetAircraft();
+            const FVector Loc = PosActor ? PosActor->GetTransform().Translation : FVector(0.0f, 0.0f, 0.0f);
+            const float Yaw = PosActor ? PosActor->GetActorRotation().Yaw : 0.0f;
+            const float Hp = Pawn && Bot->IsAlive() ? Pawn->GetHealth() : 0.0f;
+            const float Shield = Pawn && Bot->IsAlive() ? Pawn->GetShield() : 0.0f;
+            const std::string Style = Bot->GetSkills().Style ? EscapeJson(Bot->GetSkills().Style) : std::string();
+            Body += std::format("{}{{\"id\":\"b{}\",\"name\":\"{}\",\"isBot\":true,\"x\":{:.0f},\"y\":{:.0f},\"z\":{:.0f},\"yaw\":{:.1f},\"hp\":{:.0f},\"maxHp\":100,\"shield\":{:.0f},\"maxShield\":100,\"alive\":{},\"dbno\":{},\"kills\":{},\"team\":{},\"state\":\"{}\",\"goal\":\"{}\",\"style\":\"{}\"}}",
+                bFirstActor ? "" : ",", Bot->GetBotIndex(), EscapeJson(Bot->GetBotName()), Loc.X, Loc.Y, Loc.Z, Yaw, Hp, Shield,
+                Bot->IsAlive() ? "true" : "false", Bot->IsDBNO() ? "true" : "false", Bot->GetKills(), static_cast<int32_t>(Bot->GetTeam()),
+                BotStateLabel(Bot->GetState()), BotGoalLabel(Bot->GetGoal()), Style);
+            bFirstActor = false;
+        }
+    }
+
+    Body += "]}";
+    Watch->bSending = true;
+    Watch->Timer.Invalidate();
+    BackendRequest::PostJson(L"Battle Royale live telemetry", L"/fortnite/api/game/v2/matchmakingservice/telemetry",
+        std::move(Body), FFortMcpConfig::DedicatedServerClientId, FFortMcpConfig::DedicatedServerClientSecret, [Watch](uint32_t Status, const std::string& Answer)
+    {
+        GameThread::Enqueue([Watch, Status, Commands = Status == 200 ? Answer : std::string()]()
+        {
+            Watch->bSending = false;
+            AFortGameModeAthena* Athena = static_cast<AFortGameModeAthena*>(Watch->GameMode.Get());
+            if (!Athena || MatchTelemetry != Watch)
+            {
+                return;
+            }
+            if (Status == 404)
+            {
+                Watch->bUnsupported = true;
+                Log::Info(L"Battle Royale live telemetry: backend does not expose telemetry endpoint (404), stopping updates");
+                return;
+            }
+            if (!Commands.empty())
+            {
+                RunMapCommands(Athena, Commands);
+            }
+            SetGameModeTimer(Athena, Watch->Timer, TelemetryInterval, [](AFortGameModeAthena* GameMode) { GameMode->StartMatchTelemetry(); });
+        });
+    });
+#endif
+}
