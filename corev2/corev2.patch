+void UAthenaNavSystem::RepopulateOctree(UWorld* World, const wchar_t* Why)
+{
+#if WITH_SERVER_CODE
+    UNavigationSystem* NavSys = World ? World->GetNavigationSystem() : nullptr;
+    if (!bReady || !NavSys)
