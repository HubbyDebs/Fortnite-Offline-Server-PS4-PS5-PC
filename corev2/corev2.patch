+namespace
+{
+    // Fortnite-Offline-Server: live match telemetry (players, bots, storm, bus) pushed to the local backend every 0.5 s.
+    constexpr float TelemetryInterval = 0.5f;
+
+    struct FTelemetryWatch
+    {
+        FWeakObjectPtr GameMode;
+        bool bSending = false;
+        bool bUnsupported = false;
+        bool bSentPois = false;
+        FTimerHandle Timer;
+    };
+
+    std::shared_ptr<FTelemetryWatch> MatchTelemetry;
+
+    std::string EscapeJson(const std::wstring& Wide)
+    {
+        std::string Out;
+        Out.reserve(Wide.size());
+        for (const wchar_t Ch : Wide)
+        {
+            const unsigned char C = Ch < 0x80 ? static_cast<unsigned char>(Ch) : '?';
+            if (C == '"' || C == '\\')
+            {
+                Out += '\\';
+                Out += static_cast<char>(C);
+            }
+            else if (C >= 0x20)
+            {
+                Out += static_cast<char>(C);
+            }
+        }
+        return Out;
+    }
+
+    const char* BotStateLabel(ECoreAthenaBotState State)
+    {
+        switch (State)
+        {
+        case ECoreAthenaBotState::Warmup: return "Warmup";
+        case ECoreAthenaBotState::InAircraft: return "InAircraft";
+        case ECoreAthenaBotState::Skydiving: return "Skydiving";
+        case ECoreAthenaBotState::Landed: return "Landed";
+        case ECoreAthenaBotState::Dead: return "Dead";
+        default: return "Unknown";
+        }
+    }
+
+    const char* BotGoalLabel(ECoreAthenaBotGoal Goal)
+    {
+        switch (Goal)
+        {
+        case ECoreAthenaBotGoal::Loot: return "Loot";
+        case ECoreAthenaBotGoal::Search: return "Search";
+        case ECoreAthenaBotGoal::Storm: return "Storm";
+        case ECoreAthenaBotGoal::Regroup: return "Regroup";
+        case ECoreAthenaBotGoal::Harvest: return "Harvest";
+        case ECoreAthenaBotGoal::Hunt: return "Hunt";
+        case ECoreAthenaBotGoal::TravelToPOI: return "TravelToPOI";
+        case ECoreAthenaBotGoal::Wander: return "Wander";
+        default: return "";
+        }
+    }
+
+    // Fortnite-Offline-Server: what the desktop app's map asked for, in the backend's answer to the telemetry, one command a
+    // line: "teleportto\t<name>" sends the match's human players next to that player or bot (UFortCheatManager::TeleportTo,
+    // the same as "cheat teleportto <name>").
+    void RunMapCommands(AFortGameModeAthena* GameMode, const std::string& Answer)
+    {
+        size_t Start = 0;
+        while (Start < Answer.size())
+        {
+            size_t End = Answer.find('\n', Start);
+            if (End == std::string::npos)
+            {
+                End = Answer.size();
+            }
+            const std::string Line = Answer.substr(Start, End - Start);
+            Start = End + 1;
+            const size_t Tab = Line.find('\t');
+            if (Tab == std::string::npos || Line.compare(0, Tab, "teleportto") != 0)
+            {
+                continue;
+            }
+            std::wstring Target;
+            for (const char Ch : Line.substr(Tab + 1))
+            {
+                if (Ch != '\r')
+                {
+                    Target += static_cast<wchar_t>(static_cast<unsigned char>(Ch));
+                }
+            }
+            if (Target.empty())
+            {
+                continue;
+            }
+            const TArray<AFortPlayerControllerAthena*>& Alive = GameMode->AlivePlayers;
+            int32_t Sent = 0;
+            for (int32_t Index = 0; Index < Alive.Num(); ++Index)
+            {
+                AFortPlayerControllerAthena* PC = Alive[Index];
+                APawn* Pawn = PC ? PC->GetPawn() : nullptr;
+                if (!PC || (Pawn && FCoreAthenaBotManager::IsBotPawn(reinterpret_cast<UObject*>(Pawn))))
+                {
+                    continue;
+                }
+                APlayerController* Player = Cast<APlayerController>(reinterpret_cast<UObject*>(PC));
+                UFortCheatManager* Cheats = Player ? Cast<UFortCheatManager>(static_cast<UObject*>(Player->CheatManager)) : nullptr;
+                if (Cheats)
+                {
+                    Cheats->TeleportTo(FString(Target.c_str()));
+                    ++Sent;
+                }
+            }
+            Log::Info(L"Battle Royale live map: teleportto {} for {} player(s)", Target, Sent);
+        }
+    }
+}
