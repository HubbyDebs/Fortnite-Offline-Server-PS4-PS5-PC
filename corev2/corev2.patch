+void FCoreAthenaBotManager::ZeroBuildRift(AFortPawn* Pawn, float Now)
+{
+#if WITH_SERVER_CODE
+    AFortPlayerPawnAthena* Athena = Cast<AFortPlayerPawnAthena>(reinterpret_cast<UObject*>(Pawn));
+    UCharacterMovementComponent* Movement = static_cast<ACharacter*>(reinterpret_cast<APawn*>(Pawn))->CharacterMovement;
+    // Only in the match proper (not the warmup island, not after the end), and only where a skydive can be started: a
+    // rift without one would drop the player 100 m.
+    const bool bCanSkydive = AFortPlayerPawnAthena::HasIsSkydiving() && Finder::ResolveBotSkydiveLive(AFortPlayerPawnAthena::IsSkydivingOffset());
+    if (!bAircraftStarted || bMatchEnded || !bCanSkydive || !Athena || !Movement || Pawn->bIsDying || Pawn->bIsDBNO || Athena->bIsSkydiving || Athena->bIsParachuteOpen)
+    {
+        PitWatches.erase(Pawn);
+        return;
+    }
+    FPitWatch& Watch = PitWatches[Pawn];
+    Watch.LastSeen = Now;
+    const FVector Location = Pawn->GetTransform().GetLocation();
+    // Within 3 m (in a hole a player can't go further), and no hit taken meanwhile (a fight in an alley isn't a hole).
+    const float Vitals = Pawn->GetHealth() + Pawn->GetShield();
+    if (Watch.Since <= 0.0f || (FVector(Location.X - Watch.Anchor.X, Location.Y - Watch.Anchor.Y, 0.0f)).Size() > 300.0f || Vitals < Watch.Vitals)
+    {
+        Watch.Anchor = Location;
+        Watch.Since = Now;
+        Watch.Jumps = 0;
+    }
+    Watch.Vitals = Vitals;
+    // A jump: rising off the ground (a new upward move counts once).
+    const bool bRising = static_cast<FVector>(Movement->Velocity).Z > 300.0f;
+    if (bRising && !Watch.bWasRising)
+    {
+        ++Watch.Jumps;
+    }
+    Watch.bWasRising = bRising;
+    if (Now - Watch.Since < 8.0f || Watch.Jumps < 3 || Now < Watch.NextRift)
+    {
+        return;
+    }
+    // Open sky above (not a room), walls too high to jump within 5 m on at least 6 of 8 sides. Not a hole: its jumps
+    // start over (it is looked at again after three more), with no wait.
+    const int32_t Walls = PitWalls(Pawn, Location);
+    if (Walls < 6)
+    {
+        Watch.Jumps = 0;
+        return;
+    }
+    Watch.NextRift = Now + 30.0f;
+    // As the minigames' sky spawn does (FortMinigame.cpp): teleported up, then a skydive (BeginSkydiving, not from the bus).
+    const FVector Up(Location.X, Location.Y, Location.Z + 10000.0f);
+    if (!reinterpret_cast<AActor*>(Pawn)->TeleportTo(Up, reinterpret_cast<AActor*>(Pawn)->GetActorRotation()))
+    {
+        return;
+    }
+    Athena->BeginSkydiving(false);
+    Pawn->ForceNetUpdate();
+    Watch.Since = 0.0f;
+    Log::Info(L"Zero Build: a player stuck in a hole at ({:.0f}, {:.0f}, {:.0f}) ({} walls of 8, {} jumps) is taken up by a rift", Location.X, Location.Y, Location.Z, Walls, Watch.Jumps);
+#endif
+}
