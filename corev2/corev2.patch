+#pragma once
+// Fortnite-Offline-Server: the player bots' hearing of gunfire and their low-health retreat, as plain numbers so they can
+// be tested without the game (Fortnite-Offline-Server-PS4-PS5-PC: sim/tests/bot_logic_test.cpp). The ideas come from
+// Syndicate's SpectraBots (BotAwareness, BotSurvival; MIT, (c) 2026 the Syndicate team); the code is Core's.
+#include <algorithm>
+#include <string>
+
+namespace CoreAthenaBotAwareness
+{
+    // How far a shot carries (cm), roughly what a player hears in a match. Type: 1 pistol, 2 SMG, 3 assault rifle,
+    // 4 shotgun, 5 sniper, 6 launcher (ECoreAthenaBotWeaponType's order), anything else 35 m.
+    inline float ShotLoudness(int Type)
+    {
+        switch (Type)
+        {
+        case 1: return 3000.0f;
+        case 2: return 3200.0f;
+        case 3: return 4200.0f;
+        case 4: return 3600.0f;
+        case 5: return 7000.0f;
+        case 6: return 6000.0f;
+        default: return 3500.0f;
+        }
+    }
+
+    // A weapon by its definition's name (WID_Assault_Auto_Athena_R_Ore_T03...), as the bots' own WeaponTypeOf sorts them:
+    // how far its shot carries, 0 for what isn't a gun (pickaxe, building and edit tools, traps, heals), which is never
+    // taken for a shot.
+    inline float ShotLoudnessOfName(const std::wstring& Name)
+    {
+        const auto Has = [&Name](const wchar_t* Part) { return Name.find(Part) != std::wstring::npos; };
+        if (Has(L"Shotgun"))
+        {
+            return ShotLoudness(4);
+        }
+        if (Has(L"Sniper"))
+        {
+            return ShotLoudness(5);
+        }
+        if (Has(L"Assault"))
+        {
+            return ShotLoudness(3);
+        }
+        if (Has(L"Pistol_AutoHeavy") || Has(L"Pistol_Scavenger") || Has(L"SMG"))
+        {
+            return ShotLoudness(2);
+        }
+        if (Has(L"Pistol"))
+        {
+            return ShotLoudness(1);
+        }
+        if (Has(L"Launcher"))
+        {
+            return ShotLoudness(6);
+        }
+        return 0.0f;
+    }
+
+    // Awareness 0..1: hears a shot over 75-110 % of how far it carries.
+    inline float HearingScale(float Awareness) { return 0.75f + 0.35f * std::clamp(Awareness, 0.0f, 1.0f); }
+
+    // The chance an armed bot that heard a shot Distance away goes to check: likelier the closer and the more
+    // aggressive (Aggression 0..1), half as likely with fewer than two guns.
+    inline float CheckShotsChance(float Distance, float HeardRange, float Aggression, int Guns)
+    {
+        const float Near = 1.0f - std::clamp(Distance / std::max(HeardRange, 1.0f), 0.0f, 1.0f);
+        const float Press = 0.6f + 0.8f * std::clamp(Aggression, 0.0f, 1.0f);
+        return std::clamp((0.35f + 0.5f * Near) * Press, 0.1f, 0.95f) * (Guns >= 2 ? 1.0f : 0.5f);
+    }
+
+    // Reaction time while alert (it heard shots or was hit a moment ago): quicker, never at once.
+    inline float AlertedReaction(float Reaction, bool bAlert) { return bAlert ? std::max(0.12f, Reaction * 0.6f) : Reaction; }
+
+    // Health and shield below which a bot under fire breaks off (Healing 0..1: 30-50), and what it wants back (+30).
+    inline float RetreatBelow(float Healing) { return 30.0f + 20.0f * std::clamp(Healing, 0.0f, 1.0f); }
+    inline float RetreatRecovered(float Healing) { return RetreatBelow(Healing) + 30.0f; }
+
+    struct FRetreatSituation
+    {
+        float Vitals = 100.0f;          // health + shield
+        float Healing = 0.5f;           // the Healing trait
+        bool bHasHeals = false;         // carries an item that heals or shields
+        bool bUnderFire = false;        // sees its enemy or was hit in the last 1.5 s
+        bool bEnemyKnown = false;
+        float EnemyDistance = 1e9f;     // cm, only meaningful when the enemy is in sight
+        bool bEnemyInSight = false;
+        float EnemyVitals = -1.0f;      // the enemy's health + shield in sight, -1 unknown
+        bool bStorm = false;            // in the storm or running from it
+        bool bResting = false;          // a retreat ended without recovering less than 8 s ago
+    };
+
+    // Whether a bot starts breaking off now. Cornered (an enemy in sight within 4.5 m) or against a weaker enemy it fights.
+    inline bool ShouldStartRetreat(const FRetreatSituation& S)
+    {
+        if (!S.bHasHeals || !S.bUnderFire || !S.bEnemyKnown || S.bStorm || S.bResting || S.Vitals >= RetreatBelow(S.Healing))
+        {
+            return false;
+        }
+        if (S.bEnemyInSight && S.EnemyDistance < 450.0f)
+        {
+            return false;
+        }
+        return !(S.bEnemyInSight && S.EnemyVitals >= 0.0f && S.EnemyVitals + 10.0f < S.Vitals);
+    }
+    // How much a shot's aim error grows with the moment (the idea of Syndicate's HitChance, MIT, as a spread multiplier):
+    // running while firing, hit a moment ago, a target in the air, and the first shots at a new target until it has
+    // tracked it (Settle seconds). Skill (AimAccuracy / AimTracking 0..1) lowers each cost, never to nothing.
+    struct FAimSituation
+    {
+        float OwnSpeed = 0.0f;          // the bot's own horizontal speed, cm/s
+        bool bUnderPressure = false;    // hit in the last 1.5 s
+        bool bTargetAirborne = false;   // the target is jumping or falling
+        float TrackSeconds = 10.0f;     // seconds since it acquired this target
+        float Accuracy = 0.5f;          // the AimAccuracy trait
+        float Tracking = 0.5f;          // the AimTracking trait
+    };
+
+    inline float AimSituationScale(const FAimSituation& S)
+    {
+        const float A = std::clamp(S.Accuracy, 0.0f, 1.0f);
+        const float T = std::clamp(S.Tracking, 0.0f, 1.0f);
+        const float Run = std::clamp(S.OwnSpeed / 600.0f, 0.0f, 1.0f);
+        float Scale = 1.0f + (0.6f - 0.4f * A) * Run;
+        if (S.bUnderPressure)
+        {
+            Scale *= 1.4f - 0.25f * A;
+        }
+        if (S.bTargetAirborne)
+        {
+            Scale *= 1.6f - 0.3f * T;
+        }
+        const float Settle = 2.0f - 1.25f * T;
+        const float First = 1.8f - 0.45f * A;
+        const float Settled = std::clamp(S.TrackSeconds / Settle, 0.0f, 1.0f);
+        Scale *= First + (1.0f - First) * Settled;
+        return Scale;
+    }
+}
