+bool FCoreAthenaBotController::TrappedRecovery(float Now)
+{
+#if WITH_SERVER_CODE
+    // Fortnite-Offline-Server: 7.40 bots-only matches lost a quarter of their bots trapped for minutes in one place (a
+    // path into a wall, a room with no way out it could find), the storm then killing them. Its position every 5 s:
+    // within 6 m of where it was 30 s ago, out of a fight and far from its goal, it is trapped. It first walks to a
+    // navmesh point 15-25 m away in another way (8 s); trapped again within 90 s with the storm on it or coming, and
+    // no player near enough to see, it is put inside the next circle (Titanium's "unseen storm relocation" idea).
+    AFortPlayerPawnAthena* Pawn = GetPawn();
+    UWorld* World = Manager && Manager->GetGameMode() ? Manager->GetGameMode()->GetWorld() : nullptr;
+    if (!Pawn || !World || State != ECoreAthenaBotState::Landed)
+    {
+        return false;
+    }
+    const FVector Location = LastKnownPosition;
+    if (Now < RecoveryUntil)
+    {
+        if (Dist2D(Location, RecoveryGoal) < 300.0f)
+        {
+            RecoveryUntil = 0.0f;
+            return false;
+        }
+        MoveTowards(RecoveryGoal, Now, 200.0f);
+        return true;
+    }
+    if (Now < NextTrapSample)
+    {
+        return false;
+    }
+    NextTrapSample = Now + 5.0f;
+    TrapSamples.push_back({ Now, Location });
+    TrapLedgeSamples.push_back({ LedgeTurns + LedgeStops, bHasMoveGoal ? Dist2D(Location, MoveGoal) : 0.0f });
+    while (TrapLedgeSamples.size() > TrapSamples.size() + 1)
+    {
+        TrapLedgeSamples.erase(TrapLedgeSamples.begin());
+    }
+    std::erase_if(TrapSamples, [Now](const std::pair<float, FVector>& Sample) { return Now - Sample.first > 30.0f; });
+    while (TrapLedgeSamples.size() > TrapSamples.size())
+    {
+        TrapLedgeSamples.erase(TrapLedgeSamples.begin());
+    }
+    // Fortnite-Offline-Server: turned back from edges all the while (40+ ledge turns or stops in 30 s) and no closer to its
+    // goal: trapped on a summit or a roof wider than 6 m (two bots spent 5 minutes on one, 800 turns each), near its goal
+    // too (a bot turned 1885 times at an edge with an item below it).
+    const bool bLedgeLoop = TrapLedgeSamples.size() == TrapSamples.size() && !TrapLedgeSamples.empty()
+        && TrapLedgeSamples.back().first - TrapLedgeSamples.front().first > 40 && TrapLedgeSamples.back().second > TrapLedgeSamples.front().second - 1000.0f;
+    if (TrapSamples.size() < 6 || IsInCombat(Now) || !bHasMoveGoal || (Dist2D(Location, MoveGoal) < 1500.0f && !bLedgeLoop))
+    {
+        return false;
+    }
+    float Moved = 0.0f;
+    for (const auto& [Time, Where] : TrapSamples)
+    {
+        Moved = std::max(Moved, Dist2D(Location, Where));
+    }
+    // In the storm, back and forth over 20-30 m without getting any closer to the circle in 30 s is trapped too (3.6: a
+    // bot went to and fro on a path 140 m outside the circle for 100 s until the storm killed it). Its way out then
+    // starts towards the circle, to the side of the way it kept failing.
+    FVector ZoneCenter;
+    float ZoneRadius = 0.0f;
+    const bool bStormLoop = Moved > 600.0f && IsInStorm() && Manager->GetSafeZone(ZoneCenter, ZoneRadius) && ZoneRadius > 0.0f
+        && Dist2D(Location, ZoneCenter) > Dist2D(TrapSamples.front().second, ZoneCenter) - 1000.0f;
+    if (Moved > 600.0f && !bStormLoop && !bLedgeLoop)
+    {
+        return false;
+    }
+    TrapSamples.clear();
+    TrapLedgeSamples.clear();
+    ++TrappedEvents;
+    // Fortnite-Offline-Server (Zero Build): where a bot is trapped in a hole (open sky, walls on 6+ of 8 sides), for the
+    // list of the map's holes that get a rift of their own.
+    if (FCoreAthenaBotManager::bZeroBuild)
+    {
+        const int32_t Walls = FCoreAthenaBotManager::PitWalls(Pawn, Location);
+        static int32_t LoggedPits = 0;
+        if (Walls >= 6 && LoggedPits++ < 200)
+        {
+            Log::Info(L"Zero Build: hole at ({:.0f}, {:.0f}, {:.0f}): {} trapped there ({} walls of 8)", Location.X, Location.Y, Location.Z, BotName, Walls);
+        }
+    }
+    const bool bAgain = LastTrappedTime > 0.0f && Now - LastTrappedTime < 90.0f;
+    LastTrappedTime = Now;
+    static int32_t Logged = 0;
+    // Trapped again with the storm on it or coming, and unseen: inside the next circle.
+    FVector Center;
+    float Radius = 0.0f;
+    if (bAgain && (IsInStorm() || bHeadingForSafeZone) && !IsSeenByHuman(Location) && Manager->GetSafeZone(Center, Radius) && Radius > 0.0f)
+    {
+        const FVector Way = Dist2D(Location, Center) > 1.0f ? Direction2D(Center, Location) : FVector(1.0f, 0.0f, 0.0f);
+        const FVector Inside(Center.X + Way.X * Radius * 0.7f, Center.Y + Way.Y * Radius * 0.7f, Location.Z);
+        FVector Ground;
+        if (Manager->FindGroundNear(Inside, 3000.0f, Ground) && !IsSeenByHuman(Ground) && reinterpret_cast<AActor*>(Pawn)->TeleportTo(FVector(Ground.X, Ground.Y, Ground.Z + 120.0f), reinterpret_cast<AActor*>(Pawn)->GetActorRotation()))
+        {
+            ++Rescues;
+            StopMoving();
+            if (Logged++ < 40)
+            {
+                Log::Info(L"Battle Royale bots: {} was trapped at ({:.0f}, {:.0f}, {:.0f}) again with the storm coming, unseen: put inside the next circle at ({:.0f}, {:.0f}, {:.0f})",
+                    BotName, Location.X, Location.Y, Location.Z, Ground.X, Ground.Y, Ground.Z);
+            }
+            return true;
+        }
+    }
+    // A navmesh point 15-25 m away, the way back from its goal first, then around (in a storm loop: towards the circle,
+    // to either side first).
+    const FVector Back = bStormLoop ? Direction2D(Location, ZoneCenter) : Direction2D(MoveGoal, Location);
+    static constexpr float BackYaws[] = { 0.0f, 60.0f, -60.0f, 120.0f, -120.0f, 180.0f };
+    static constexpr float ZoneYaws[] = { 60.0f, -60.0f, 0.0f, 120.0f, -120.0f, 180.0f };
+    for (const float Length : { 2500.0f, 1500.0f })
+    {
+        for (const float Yaw : bStormLoop ? ZoneYaws : BackYaws)
+        {
+            const FVector Way = RotateYaw(Back, Yaw);
+            FVector Point;
+            if (UAthenaNavSystem::ProjectPointToNavigation(World, FVector(Location.X + Way.X * Length, Location.Y + Way.Y * Length, Location.Z), Point, FVector(300.0f, 300.0f, 800.0f))
+                && !(Now - LastRecoveryTime < 90.0f && Dist2D(Point, LastRecoveryGoal) < 500.0f))
+            {
+                RecoveryGoal = Point;
+                LastRecoveryGoal = Point;
+                LastRecoveryTime = Now;
+                RecoveryUntil = Now + 8.0f;
+                if (Logged++ < 40)
+                {
+                    Log::Info(L"Battle Royale bots: {} is trapped at ({:.0f}, {:.0f}, {:.0f}) (moved {:.0f} m in 30 s{}): it gets out towards ({:.0f}, {:.0f}, {:.0f})", BotName, Location.X, Location.Y,
+                        Location.Z, Moved / 100.0f, bStormLoop ? L", in the storm and no closer to the circle" : L"", Point.X, Point.Y, Point.Z);
+                }
+                MoveTowards(RecoveryGoal, Now, 200.0f);
+                return true;
+            }
+        }
+    }
+    return false;
+#else
+    return false;
+#endif
+}
