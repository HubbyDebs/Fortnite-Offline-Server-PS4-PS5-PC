+bool FCoreAthenaBotController::AvoidLedge(FVector& Direction, float Now)
+{
+#if WITH_SERVER_CODE
+    // Fortnite-Offline-Server: steering without a path, the bot walked straight off cliffs (7.40: bots landed on Polar
+    // Peak's castle, 150 m up, and three of 25 died of the fall heading for the circle). The ground 1.2 m ahead is
+    // looked at (every 0.2 s): more than two storeys down, the bot turns to the first way that has ground, else stops.
+    constexpr float ProbeAhead = 120.0f;
+    AFortPlayerPawnAthena* Pawn = GetPawn();
+    UCharacterMovementComponent* Movement = Pawn ? static_cast<ACharacter*>(reinterpret_cast<APawn*>(Pawn))->CharacterMovement : nullptr;
+    if (!Pawn || !Movement || Movement->MovementMode != MoveWalking || Direction.SizeSquared() < 0.01f)
+    {
+        return true;
+    }
+    if (Now < NextLedgeCheck && Direction.X * LedgeAskedWay.X + Direction.Y * LedgeAskedWay.Y < 0.7f)
+    {
+        NextLedgeCheck = 0.0f;
+    }
+    if (Now < NextLedgeCheck)
+    {
+        if (bLedgeBlocked)
+        {
+            return false;
+        }
+        if (bLedgeTurned)
+        {
+            Direction = LedgeDirection;
+        }
+        return true;
+    }
+    // Fortnite-Offline-Server: every 0.1 s, and further ahead the faster it goes (half a second of its speed): sprinting
+    // at 5.5 m/s, a 1.2 m look every 0.2 s let a bot reach an edge between two looks (a 7.40 bot that landed on the
+    // mountain by Snobby Shores walked off it heading for the circle and fell 70 m).
+    NextLedgeCheck = Now + 0.1f;
+    LedgeAskedWay = Direction;
+    const FVector Location = LocationOf(Pawn);
+    const FVector Velocity = static_cast<FVector>(Movement->Velocity);
+    const float Ahead = std::clamp(std::sqrt(Velocity.X * Velocity.X + Velocity.Y * Velocity.Y) * 0.5f, ProbeAhead, 300.0f);
+    const auto HasGround = [&](const FVector& Way) { return HasGroundAhead(Way, Ahead); };
+    bLedgeBlocked = false;
+    bLedgeTurned = false;
+    if (HasGround(Direction))
+    {
+        return true;
+    }
+    // Fortnite-Offline-Server: what it carries towards the edge goes (as against a wall): sprinting at 5.5 m/s, a turn
+    // takes the pawn half a second, and it went on over the edge it had seen (about 25 falls of 10-28 m in 75 bots, all
+    // while steering by hand after a path was dropped at a ledge).
+    {
+        FVector Carried = static_cast<FVector>(Movement->Velocity);
+        const float Into = Carried.X * Direction.X + Carried.Y * Direction.Y;
+        if (Into > 0.0f)
+        {
+            Carried.X -= Direction.X * Into;
+            Carried.Y -= Direction.Y * Into;
+            Movement->Velocity = Carried;
+        }
+    }
+    for (const float Yaw : { 45.0f, -45.0f, 90.0f, -90.0f, 135.0f, -135.0f })
+    {
+        const FVector Turned = RotateYaw(Direction, Yaw);
+        if (HasGround(Turned))
+        {
+            Direction = Turned;
+            LedgeDirection = Turned;
+            bLedgeTurned = true;
+            ++LedgeTurns;
+            return true;
+        }
+    }
+    bLedgeBlocked = true;
+    ++LedgeStops;
+    SteerReason = L"ledge ahead";
+    return false;
+#else
+    return true;
+#endif
+}
+
+bool FCoreAthenaBotController::HasGroundAhead(const FVector& Way, float Ahead) const
+{
+#if WITH_SERVER_CODE
+    // Fortnite-Offline-Server: ground no more than two storeys below the bot's feet, Ahead cm along Way (AvoidLedge, and
+    // the steps a fight takes: strafing and backing off). Uphill, Probe can start under the slope (a 10 deg rise over the
+    // 2.75 m a sprint looks ahead) and the landscape, one-sided, isn't hit from below: 70 false ledge turns per bot on
+    // 3.6. A miss is looked at again from a 45 deg slope's height (steeper isn't walkable) before it counts as a drop.
+    constexpr float MaxSafeDrop = 800.0f;
+    constexpr float FeetOffset = 75.0f;
+    AFortPlayerPawnAthena* Pawn = GetPawn();
+    if (!Pawn)
+    {
+        return true;
+    }
+    const FVector Location = LocationOf(Pawn);
+    const FVector Probe(Location.X + Way.X * Ahead, Location.Y + Way.Y * Ahead, Location.Z + 50.0f);
+    const FVector Bottom(Probe.X, Probe.Y, Location.Z - FeetOffset - MaxSafeDrop);
+    FVector Floor;
+    bool bFound = UKismetSystemLibrary::LineTraceSingle(Pawn, Probe, Bottom, 0, false, true, Floor)
+        || UKismetSystemLibrary::LineTraceSingle(Pawn, FVector(Probe.X, Probe.Y, Probe.Z + Ahead), Bottom, 0, false, true, Floor);
+    if (!bFound)
+    {
+        return false;
+    }
+    // Fortnite-Offline-Server: more than 2 m down, ground 3 m further on too, at most 10 m below the feet: a cliff's face
+    // 3-8 m down counted as ground, and bots on a path along a cliff's top walked onto it and slid 25-50 m (3.6's cliff
+    // east of the river). A steep mountainside still goes down (a 1 m look for a slope over 50 deg left two bots on a
+    // summit for 5 minutes).
+    if (Location.Z - FeetOffset - Floor.Z > 200.0f)
+    {
+        const FVector Further(Probe.X + Way.X * 300.0f, Probe.Y + Way.Y * 300.0f, Probe.Z);
+        FVector FurtherFloor;
+        // And not a face steeper than about 57 deg over those 3 m (4.6 m lower): the navmesh's slopes stop at 44.5 deg, and
+        // two bots on a storm path walked onto the big mountain's face and fell 48 m at the same spot.
+        if (!UKismetSystemLibrary::LineTraceSingle(Pawn, Further, FVector(Further.X, Further.Y, Location.Z - FeetOffset - 1000.0f), 0, false, true, FurtherFloor)
+            || Floor.Z - FurtherFloor.Z > 460.0f)
+        {
+            return false;
+        }
+    }
+    return true;
+#else
+    return true;
+#endif
+}
+
