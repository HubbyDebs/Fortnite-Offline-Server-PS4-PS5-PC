+void FCoreAthenaBotController::LogMatchStats() const
+{
+#if WITH_SERVER_CODE
+    // Fortnite-Offline-Server: one line a bot, never capped, read by tools/bot_sim.py for the tuning reports.
+    const auto Quoted = [](const std::wstring& Text)
+    {
+        std::wstring Out;
+        for (const wchar_t Ch : Text)
+        {
+            if (Ch == L'"' || Ch == L'\\')
+            {
+                Out += L'\\';
+            }
+            if (Ch >= 0x20)
+            {
+                Out += Ch;
+            }
+        }
+        return Out;
