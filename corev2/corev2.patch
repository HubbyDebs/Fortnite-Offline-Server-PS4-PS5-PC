 void UGameEngine::TickHK(UGameEngine* This, float DeltaSeconds, bool bIdleMode)
 {
+#if WITH_SERVER_CODE
+    const auto Start = FServerTickMonitor::Clock::now();
+    double GapMs = 0.0;
+    if (ServerTickMonitor.bInitialized)
+    {
+        GapMs = std::chrono::duration<double, std::milli>(Start - ServerTickMonitor.LastTickStart).count();
+    }
+    else
+    {
+        ServerTickMonitor.WindowStart = Start;
+        ServerTickMonitor.bInitialized = true;
+    }
+    ServerTickMonitor.LastTickStart = Start;
+#endif
     GameThread::Tick();
 #if !UE_SERVER
     APlayerController::EnsureLocalCheatManager(This->GameInstance);
 #endif
     TickOG(This, DeltaSeconds, bIdleMode);
+#if WITH_SERVER_CODE
+    const auto End = FServerTickMonitor::Clock::now();
+    const double TickMs = std::chrono::duration<double, std::milli>(End - Start).count();
+    ++ServerTickMonitor.Frames;
+    ServerTickMonitor.SumTickMs += TickMs;
+    if (TickMs > ServerTickMonitor.MaxTickMs)
+    {
+        ServerTickMonitor.MaxTickMs = TickMs;
+    }
+    if (GapMs > ServerTickMonitor.MaxGapMs)
+    {
+        ServerTickMonitor.MaxGapMs = GapMs;
+    }
+    if (TickMs > ServerSlowTickThresholdMs)
+    {
+        ++ServerTickMonitor.SlowTicks;
+        if (ServerTickMonitor.SpikesLogged < MaxLoggedServerSpikes)
+        {
+            ++ServerTickMonitor.SpikesLogged;
+            Log::Warning(L"ServerTick: slow server frame {:.1f} ms (gap {:.1f} ms, DeltaSeconds {:.3f} s)", TickMs, GapMs, DeltaSeconds);
+        }
+    }
+    const double ElapsedSec = std::chrono::duration<double>(End - ServerTickMonitor.WindowStart).count();
+    if (ElapsedSec >= ServerTickSummarySeconds && ServerTickMonitor.Frames > 0)
+    {
+        const double AvgMs = ServerTickMonitor.SumTickMs / static_cast<double>(ServerTickMonitor.Frames);
+        Log::Info(L"ServerTick: last {:.0f} s: {} frames ({:.1f} Hz), work avg {:.2f} ms, max {:.1f} ms, max frame gap {:.1f} ms, {} ticks >{:.0f} ms",
+            ElapsedSec, ServerTickMonitor.Frames, static_cast<double>(ServerTickMonitor.Frames) / ElapsedSec,
+            AvgMs, ServerTickMonitor.MaxTickMs, ServerTickMonitor.MaxGapMs, ServerTickMonitor.SlowTicks, ServerSlowTickThresholdMs);
+        ServerTickMonitor.WindowStart = End;
+        ServerTickMonitor.SumTickMs = 0.0;
+        ServerTickMonitor.MaxTickMs = 0.0;
+        ServerTickMonitor.MaxGapMs = 0.0;
+        ServerTickMonitor.Frames = 0;
+        ServerTickMonitor.SlowTicks = 0;
+    }
+#endif
 }
 
