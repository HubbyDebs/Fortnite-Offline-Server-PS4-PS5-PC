+void UAthenaNavSystem::UnregisterNavigationInvoker(AActor* Invoker)
+{
+    // Fortnite-Offline-Server: a dead bot's pawn stays a while (its death, then the engine's destroy), and while it is an
+    // invoker its tiles count in the once-a-second UpdateActiveTiles, whose cost grows with the square of the tiles; a
+    // quarter of the bots die in the first minute on the ground, the busiest one.
+    UWorld* World = Invoker && bInitialized && !bLevelNavData ? Invoker->GetWorld() : nullptr;
+    UNavigationSystem* NavSys = World ? World->GetNavigationSystem() : nullptr;
+    const bool bUnregistered = NavSys && NavSys->UnregisterNavigationInvoker(Invoker);
+    static bool bLogged = false;
+    if (NavSys && !bLogged)
+    {
+        bLogged = true;
+        Log::Info(L"Battle Royale navigation: a dead bot's invoker {}", bUnregistered ? L"unregistered" : L"couldn't be unregistered (UnregisterNavigationInvoker not found)");
+    }
+    if (bUnregistered)
+    {
+        const UObject* Object = reinterpret_cast<const UObject*>(Invoker);
+        std::erase_if(TileCache.Invokers, [Object](const FWeakObjectPtr& Entry) { return !Entry.Get() || Entry.Get() == Object; });
+    }
+}
