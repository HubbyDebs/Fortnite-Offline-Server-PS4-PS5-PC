+int32_t FCoreAthenaBotManager::PitWalls(UObject* Context, const FVector& Location)
+{
+#if WITH_SERVER_CODE
+    const FVector Chest(Location.X, Location.Y, Location.Z + 40.0f);
+    // Above a jump too (1.5 m over the capsule's middle): a fence, a car, a rock or a walkable slope blocks the chest's
+    // trace and not this one, so only what is too high to jump out of counts as a wall.
+    const FVector High(Location.X, Location.Y, Location.Z + 150.0f);
+    FVector Hit;
+    if (UKismetSystemLibrary::LineTraceSingle(Context, Chest, FVector(Chest.X, Chest.Y, Chest.Z + 1500.0f), 0, false, true, Hit))
+    {
+        return -1;
+    }
+    int32_t Walls = 0;
+    for (int32_t Side = 0; Side < 8; ++Side)
+    {
+        const float Yaw = static_cast<float>(Side) * 0.785398f;
+        const FVector Way(std::cos(Yaw), std::sin(Yaw), 0.0f);
+        if (UKismetSystemLibrary::LineTraceSingle(Context, Chest, Chest + Way * 500.0f, 0, false, true, Hit)
+            && UKismetSystemLibrary::LineTraceSingle(Context, High, High + Way * 500.0f, 0, false, true, Hit))
+        {
+            ++Walls;
+        }
+    }
+    return Walls;
+#else
+    return -1;
+#endif
+}
