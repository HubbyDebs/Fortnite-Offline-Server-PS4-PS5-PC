+bool FCoreAthenaBotController::EscapeUnarmed(float Now, const FVector& Location, const FVector& EnemyLocation)
+{
+#if WITH_SERVER_CODE
+    // Nothing to shoot with and an enemy close that just hurt it: away from them, sprinting, for a few seconds (21.40's
+    // "escape" with no ammo); then it loots as before.
+    if (EscapeUntil <= Now)
+    {
+        EscapeUntil = Now + 5.0f;
+        NoteTakeHeight(ETakeHeightStat::Escapes);
+        static int32_t Logged = 0;
+        if (Logged++ < 10)
+        {
+            Log::Info(L"Battle Royale bots: {} has nothing to shoot with and runs from an enemy {:.0f} m away", BotName, Dist2D(Location, EnemyLocation) / 100.0f);
+        }
+    }
+    StopFiring();
+    SetTargeting(false);
+    SetMovementStyle(true, Now);
+    FVector Away = Direction2D(EnemyLocation, Location);
+    FVector EscapeGoal = Location + Away * 2000.0f;
+    FVector ZoneCenter;
+    float ZoneRadius = 0.0f;
+    if (Manager && Manager->GetSafeZone(ZoneCenter, ZoneRadius) && ZoneRadius > 0.0f && Dist2D(EscapeGoal, ZoneCenter) > ZoneRadius)
+    {
+        const FVector ToZone = Direction2D(Location, ZoneCenter);
+        FVector Blended(Away.X + ToZone.X, Away.Y + ToZone.Y, 0.0f);
+        const float Len = Blended.Size();
+        EscapeGoal = Location + (Len > 0.01f ? Blended * (2000.0f / Len) : ToZone * 2000.0f);
+    }
+    MoveTowards(EscapeGoal, Now, 300.0f);
+    return true;
+#else
+    return false;
+#endif
+}
