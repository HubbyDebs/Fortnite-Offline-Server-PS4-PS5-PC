+FCoreAIBotSkills FCoreAthenaBotManager::SkillsForNewBot() const
+{
+    if (!Settings.bHasTraits && !Settings.bMixed)
+    {
+        return SkillsForLevel(Settings.Level);
+    }
+    const FCoreBotTraits Base = Settings.bHasTraits ? Settings.Traits : TraitsForLevel(Settings.Level);
+    if (!Settings.bMixed)
+    {
+        return SkillsForTraits(Base);
+    }
+    // A mixed match (Core's 🟡): each bot gets a skill tier and a play style around the settings' traits, the way a public
+    // lobby mixes new players, regulars and the odd sweat, each playing their own way.
+    // Fortnite-Offline-Server: Syndicate's lobby (SyndicateClassic BotSkillPolicy ResolveVariety, MIT): 15% beginners,
+    // 30% average, 30% above average, 20% advanced, 5% pros, centred on the settings (a trait step of 0.11 is a level).
+    struct FTier { float Odds; float Offset; };
+    static constexpr FTier Tiers[] = { { 0.15f, -0.40f }, { 0.30f, -0.20f }, { 0.30f, 0.0f }, { 0.20f, 0.15f }, { 0.05f, 0.30f } };
+    float Roll = FMath::FRand();
+    float TierOffset = 0.0f;
+    for (const FTier& Tier : Tiers)
+    {
+        TierOffset = Tier.Offset;
+        if ((Roll -= Tier.Odds) < 0.0f)
+        {
+            break;
+        }
+    }
+    FCoreBotTraits T = Base;
+    // The skill traits move with the tier; the behaviour traits only by half of it.
+    for (float* Value : { &T.AimAccuracy, &T.AimTracking, &T.ReactionSpeed, &T.FiringFrequency, &T.Prediction, &T.Awareness,
+        &T.BuildFrequency, &T.BuildSpeed, &T.DefensiveBuilding, &T.HeightSeeking, &T.EditFrequency, &T.EditSpeed })
+    {
+        *Value += TierOffset;
+    }
+    for (float* Value : { &T.Aggression, &T.Pursuit, &T.Strafing, &T.Jumping, &T.Rotation })
+    {
+        *Value += TierOffset * 0.5f;
+    }
+    const wchar_t* Style = L"balanced";
+    const float StyleRoll = FMath::FRand();
+    if (StyleRoll < 0.15f)
+    {
+        // Lands quiet, loots everything and avoids fights until the end.
+        Style = L"looter";
+        T.Aggression -= 0.3f; T.Pursuit -= 0.2f; T.Looting += 0.3f; T.Harvesting += 0.2f; T.Healing += 0.15f;
+    }
+    else if (StyleRoll < 0.30f)
+    {
+        // Goes after whoever it sees and keeps after them.
+        Style = L"rusher";
+        T.Aggression += 0.3f; T.Pursuit += 0.3f; T.Healing -= 0.15f; T.Looting -= 0.1f;
+    }
+    else if (StyleRoll < 0.45f)
+    {
+        // Builds at the first shot and takes height.
+        Style = L"builder";
+        T.BuildFrequency += 0.3f; T.BuildSpeed += 0.2f; T.DefensiveBuilding += 0.3f; T.HeightSeeking += 0.25f; T.Harvesting += 0.25f;
+    }
+    else if (StyleRoll < 0.60f)
+    {
+        // Holds a spot, sees far, boxes up and heals early.
+        Style = L"camper";
