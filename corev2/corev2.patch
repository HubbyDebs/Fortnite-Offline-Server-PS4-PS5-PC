+bool FCoreAthenaBotController::IsSeenByHuman(const FVector& Location) const
+{
+#if WITH_SERVER_CODE
+    // A human player within 200 m could be looking: nothing is moved by hand where a player could see it.
+    AFortGameModeAthena* GameMode = Manager ? Manager->GetGameMode() : nullptr;
+    if (!GameMode)
+    {
+        return true;
+    }
+    const TArray<AFortPlayerControllerAthena*>& Alive = GameMode->AlivePlayers;
+    for (int32_t Index = 0; Index < Alive.Num(); ++Index)
+    {
+        AFortPlayerControllerAthena* PC = Alive[Index];
+        APawn* Human = PC ? PC->GetPawn() : nullptr;
+        if (Human && !FCoreAthenaBotManager::IsBotPawn(reinterpret_cast<UObject*>(Human)) && Dist2D(LocationOf(reinterpret_cast<AActor*>(Human)), Location) < 20000.0f)
+        {
+            return true;
+        }
+    }
+    return false;
+#else
+    return true;
+#endif
+}
