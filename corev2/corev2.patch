+    const float Trait = std::clamp(AIBotSkills.Traits.Looting, 0.0f, 1.0f);
+    const bool bDone = NextPOI >= 0 || (HasUsableWeapon() && LandedSeconds - AreaStartLanded > 60.0f + 120.0f * Trait);
