+    if (!Pawn || !Movement || State != ECoreAthenaBotState::Landed)
+    {
+        if (bTakingHeight)
+        {
+            EndTakeHeight(L"it isn't on its feet");
+        }
+        return false;
+    }
+    const FVector Location = LocationOf(Pawn);
+    if (bTakingHeight)
+    {
+        // The climb: the queue built the ramps (it ran before this), now the bot walks up them to the top.
+        AFortPawn* Target = HeightTarget.Get();
+        if (!Target || Target->bIsDying || Pawn->bIsDBNO || bHeadingForSafeZone)
+        {
+            NoteTakeHeight(ETakeHeightStat::Lost);
+            EndTakeHeight(bHeadingForSafeZone ? L"the storm comes first" : L"its target is gone");
+            return false;
+        }
+        if (!bHeightAscending)
+        {
+            bHeightAscending = true;
+            HeightAscendUntil = Now + 1.5f + static_cast<float>(HeightSteps) * 1.2f;
+        }
+        if (Location.Z >= HeightStepZ - 120.0f && Dist2D(Location, HeightTopPoint) < 140.0f)
+        {
+            NoteTakeHeight(ETakeHeightStat::Reached);
+            EndTakeHeight(L"it is on top");
+            return false;
+        }
+        if (Now > HeightAscendUntil || (Movement->MovementMode == MoveWalking && Location.Z < HeightStartZ - 150.0f))
+        {
+            NoteTakeHeight(ETakeHeightStat::Unfinished);
+            EndTakeHeight(L"it couldn't get up its ramps");
+            return false;
+        }
+        // Straight up the ramps by input (the navmesh doesn't know a build this new), looking at its target.
+        StopMoving();
+        SetMovementStyle(true, Now);
+        Pawn->AddMovementInput(Direction2D(Location, HeightTopPoint), 1.0f, false);
+        FaceTowards(LocationOf(Target), Now, 0.3f);
+        return true;
+    }
+
+    // Whether to start one: looked at every second and a half, on the enemy it is fighting and can see (never in Zero Build).
+    if (AIBotSkills.Building.TakeHeightOdds <= 0.0f || Now < NextTakeHeightLook || FCoreAthenaBotManager::bZeroBuild)
+    {
+        return false;
+    }
+    NextTakeHeightLook = Now + 1.5f;
+    AFortPawn* Target = CurrentTarget.Get();
+    if (!Target || Target->bIsDying || Pawn->bIsDBNO || bHeadingForSafeZone || Now - LastTargetInSightTime > 0.6f || Movement->MovementMode != MoveWalking
+        || !HasUsableWeapon() || Natives::ABuildingActor_InitializeBuildingActorIndex < 0 || Natives::ABuildingActor_PostInitializeSpawnedBuildingActorIndex < 0)
+    {
+        return false;
+    }
+    const FVector TargetLocation = LocationOf(Target);
+    const float Above = TargetLocation.Z - Location.Z;
+    // Only an enemy at least most of a floor above is worth a climb (nothing is counted for one that isn't).
+    if (Above < 250.0f)
+    {
+        return false;
+    }
+    const float Distance = Dist2D(Location, TargetLocation);
+    if (Distance < 300.0f || Distance > 3000.0f)
+    {
+        NoteTakeHeight(ETakeHeightStat::SkipRange);
+        return false;
+    }
+    if (Now < NextTakeHeightTime)
+    {
+        NoteTakeHeight(ETakeHeightStat::SkipCooldown);
+        return false;
+    }
+    // Ramps for the floors it has to make up, at most its trait's; a ramp and a wall a floor.
+    const int32_t Floors = std::clamp(static_cast<int32_t>(std::ceil(Above / BuildingLevelHeight)), 1, std::max(AIBotSkills.Building.TakeHeightMaxSteps, 1));
+    const int32_t Most = std::max({ Materials[0], Materials[1], Materials[2] });
+    if (Most < BuildingPieceCost * 2 * Floors)
+    {
+        // Short of materials ("dry"): it fights from where it is.
+        NoteTakeHeight(ETakeHeightStat::SkipMaterials);
+        return false;
+    }
+    // Room above: nothing over its head for the floors it means to climb.
+    FVector Hit;
+    UObject* HitActor = nullptr;
+    UObject* HitComponent = nullptr;
+    // Straight up, and along the ramps' slope towards the target (a ramp climbs a floor a cell): a roof or a branch over
+    // the stair stops the climb as one overhead does.
+    const FVector Eye(Location.X, Location.Y, Location.Z + 60.0f);
+    const FVector Toward = Direction2D(Location, TargetLocation);
+    const float Rise = BuildingLevelHeight * static_cast<float>(Floors);
+    if (UKismetSystemLibrary::LineTraceSingle(Pawn, Eye, FVector(Eye.X, Eye.Y, Eye.Z + Rise), 0, false, true, Hit, HitActor, HitComponent)
+        || UKismetSystemLibrary::LineTraceSingle(Pawn, Eye, Eye + Toward * (BuildingCellSize * static_cast<float>(Floors)) + FVector(0.0f, 0.0f, Rise), 0, false, true, Hit, HitActor, HitComponent))
+    {
+        NoteTakeHeight(ETakeHeightStat::SkipHeadroom);
+        return false;
+    }
+    if (FMath::FRand() > AIBotSkills.Building.TakeHeightOdds)
+    {
+        NoteTakeHeight(ETakeHeightStat::SkipRoll);
+        return false;
+    }
+    // A wall under each ramp's top, ramp after ramp up the grid towards the target (BuildWayUp's two-ramp stair, longer).
+    std::vector<FCoreAthenaBotBuildDescriptor> Descriptors;
+    for (int32_t Floor = 0; Floor < Floors; ++Floor)
+    {
+        Descriptors.push_back({ { Floor, 0, Floor }, ECoreOrientedConstructionBuildingType::WallForward });
+        Descriptors.push_back({ { Floor, 0, Floor }, ECoreOrientedConstructionBuildingType::RampForward });
+    }
+    const FCoreAthenaBotBuildingSkills& Skills = AIBotSkills.Building;
+    if (!StartBuildingQueue(Now, TargetLocation, Descriptors, Skills.InitialBuildDelay, Skills.SamePieceBuildDelay, Skills.SamePieceBuildDelayRandomDeviation,
+        Skills.DifferentPieceBuildDelay, Skills.DifferentPieceBuildDelayRandomDeviation, L"ramps to take height", true))
+    {
+        NoteTakeHeight(ETakeHeightStat::SkipNoRamp);
+        NextTakeHeightTime = Now + 5.0f;
+        return false;
+    }
+    // The ramps must follow on from the first, each a floor up from the last: the climb stops where one was left out.
+    int32_t Ramps = 0;
+    std::vector<FCoreAthenaBotBuildDescriptor> Kept;
+    for (const FCoreAthenaBotBuildDescriptor& Descriptor : BuildQueue.Descriptors)
+    {
+        if (Descriptor.BuildingType == ECoreOrientedConstructionBuildingType::RampForward)
+        {
+            if (Descriptor.Location[0] != Ramps || Descriptor.Location[2] != Ramps)
+            {
+                break;
+            }
+            ++Ramps;
+        }
+        else if (Descriptor.Location[0] > Ramps)
+        {
+            break;
+        }
+        Kept.push_back(Descriptor);
+    }
+    if (Ramps == 0)
+    {
+        ClearBuildingQueue();
+        NoteTakeHeight(ETakeHeightStat::SkipNoRamp);
+        NextTakeHeightTime = Now + 5.0f;
+        return false;
+    }
+    BuildQueue.Descriptors = std::move(Kept);
+    // The top: the last ramp's high end, a step short of its edge (there is no floor past it: a step past it walked the
+    // bot off its own ramp).
+    int32_t ForwardX = 0;
+    int32_t ForwardY = 0;
+    GridAxis(BuildQueue.Forward, ForwardX, ForwardY);
+    const float Along = BuildingCellSize * (static_cast<float>(Ramps) - 0.5f) - 60.0f;
+    HeightTopPoint = FVector(BuildQueue.CellMinX + BuildingCellSize * 0.5f + static_cast<float>(ForwardX) * Along,
+        BuildQueue.CellMinY + BuildingCellSize * 0.5f + static_cast<float>(ForwardY) * Along, BuildQueue.BaseZ + BuildingLevelHeight * static_cast<float>(Ramps));
+    HeightTarget = Target;
+    bTakingHeight = true;
+    bHeightAscending = false;
+    HeightSteps = Ramps;
+    HeightStartZ = Location.Z;
+    HeightStepZ = HeightTopPoint.Z;
+    NextTakeHeightTime = Now + Skills.TakeHeightCooldown;
+    NoteTakeHeight(ETakeHeightStat::Started);
+    static int32_t Logged = 0;
+    if (Logged++ < 20)
+    {
+        Log::Info(L"Battle Royale bots: {} takes height on {} ({:.0f} m above, {:.0f} m away): {} ramp{} with walls", BotName, NameOf(Target), Above / 100.0f, Distance / 100.0f,
+            Ramps, Ramps == 1 ? L"" : L"s");
+    }
+    return false;
+#else
+    return false;
+#endif
+}
+
+void FCoreAthenaBotController::EndTakeHeight(const wchar_t* Why)
+{
+    static int32_t Logged = 0;
+    if (bTakingHeight && Logged++ < 20)
+    {
+        Log::Info(L"Battle Royale bots: {} ends its climb: {}", BotName, Why);
+    }
+    bTakingHeight = false;
+    bHeightAscending = false;
+    HeightTarget = nullptr;
+    HeightSteps = 0;
+}
