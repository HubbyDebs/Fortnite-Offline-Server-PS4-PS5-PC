+void FCoreAthenaBotManager::NoteGunshot(int32_t ShooterTeam, const FVector& Where, float Range, float Now)
+{
+    // A few seconds' worth: older shots are forgotten, and a burst from one spot counts once a quarter second.
+    std::erase_if(RecentGunshots, [Now](const FHeardShot& Shot) { return Now - Shot.Time > 3.0f || Shot.Time > Now; });
+    for (FHeardShot& Shot : RecentGunshots)
+    {
+        if (Shot.Team == ShooterTeam && Now - Shot.Time < 0.25f && (Shot.Where - Where).SizeSquared() < 200.0f * 200.0f)
+        {
+            return;
+        }
+    }
+    if (RecentGunshots.size() >= 64)
+    {
+        RecentGunshots.erase(RecentGunshots.begin());
+    }
+    RecentGunshots.push_back({ Where, Now, Range, ShooterTeam });
+}
