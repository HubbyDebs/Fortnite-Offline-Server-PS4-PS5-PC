+        return;
+    }
+    NavSys->SetNavigationOctreeLock(false);
+    // The POI sublevels' meshes streamed in since boot: on 3.6 nothing gave them a navigation collision, so the houses'
+    // walls and floors were left out of the octree and the bots' paths went through them.
+    UNavCollision::CreateMissing(Why);
+    const double Started = NowMs();
+    NavSys->ConditionalPopulateNavOctree();
+    const double OctreeMs = NowMs() - Started;
+    NavSys->RebuildAll();
+    Log::Info(L"Battle Royale navigation: octree populated again ({}) in {:.0f} ms, navmesh rebuilt around the invokers", Why, OctreeMs);
+#endif
+}
