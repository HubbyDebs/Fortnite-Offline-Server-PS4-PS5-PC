+        Spells += std::format(L"{}\"loot stop: {}\":[{},0]", Spells.empty() ? L"" : L",", Quoted(Key), Count);
+    }
+    std::wstring BreakBy;
+    for (const auto& [Key, Count] : BreakThroughsByWhy)
+    {
+        BreakBy += std::format(L"{}\"{}\":{}", BreakBy.empty() ? L"" : L",", Quoted(Key), Count);
+    }
+    const FCoreBotTraits& T = AIBotSkills.Traits;
+    Log::Info(L"Battle Royale bots: match stats {{\"stillSpells\":{{{}}},\"stillByIntent\":{{{}}},\"breakThroughsByWhy\":{{{}}},\"death\":\"{}\",\"trapped\":{},\"rescues\":{},\"sidesteps\":{},\"ledgeTurns\":{},\"ledgeStops\":{},\"stormSeconds\":{:.0f},\"rotation\":{:.2f},\"pathSeconds\":{:.0f},\"steerSeconds\":{{{}}},\"bot\":\"{}\",\"style\":\"{}\",\"alive\":{},\"kills\":{},\"aim\":{:.2f},\"buildFrequency\":{:.2f},\"aggression\":{:.2f},"
