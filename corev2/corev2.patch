+        StormSeconds, T.Rotation, PathSeconds, Steer, Quoted(BotName), Quoted(AIBotSkills.Style ? AIBotSkills.Style : L""), IsAlive() ? L"true" : L"false", Kills, T.AimAccuracy, T.BuildFrequency, T.Aggression,
